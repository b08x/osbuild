#!/usr/bin/env bash
# syncopated-firstboot: first-login splash, run as the logged-in user.
#   System:   update the system with dnf, run ansible-pull when the image
#             carries an ansible-pull configuration, offer a reboot when
#             updates were installed, set the default boot target, report
#             installed tools.
#   Dotfiles: print the commands that clone a dotfiles repository with yadm
#             and run `yadm bootstrap`. The script does not run them; the user
#             runs them when ready.
# After the commands are printed the marker is written and setup is complete.
#
# The autostart launcher (syncopated-firstboot-launcher) stops opening this
# script once the per-user marker exists. Running it by name always shows the
# splash, so setup can be repeated at any time.
#
# Overrides (used by the bats tests): SYNCOPATED_OS_RELEASE,
# SYNCOPATED_YADM_URL, SYNCOPATED_DOTFILES_URL, SYNCOPATED_CHECK_TOOLS,
# SYNCOPATED_ANSIBLE_PULL_CONF (path of the ansible-pull configuration),
# SYNCOPATED_NO_ANIM=1 (skip the splash reveal delay),
# SYNCOPATED_PAUSE_ON_EXIT=1 (set by the launcher: wait for Enter before
# exiting).

OS_RELEASE=${SYNCOPATED_OS_RELEASE:-/etc/os-release}
STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/syncopated
MARKER=$STATE_DIR/firstboot.done
YADM_URL=${SYNCOPATED_YADM_URL:-https://github.com/yadm-dev/yadm/raw/master/yadm}
DOTFILES_URL=${SYNCOPATED_DOTFILES_URL:-https://github.com/b08x/dots.git}
# Written into the image when osbuild_ansible_pull_repo and
# osbuild_ansible_pull_args are set; defines ANSIBLE_PULL_REPO (string) and
# ANSIBLE_PULL_ARGS (array). Without the file there is no ansible_pull step.
ANSIBLE_PULL_CONF=${SYNCOPATED_ANSIBLE_PULL_CONF:-/etc/syncopated-ansible-pull.conf}
read -r -a CHECK_TOOLS <<<"${SYNCOPATED_CHECK_TOOLS:-git yadm gum ansible podman zsh flatpak nvidia-smi}"

# Step return codes.
RC_OK=0
RC_FAILED=1
RC_SKIPPED=2

SYSTEM_STEPS=(update target)
ANSIBLE_PULL_ENABLED=0
if [[ -r $ANSIBLE_PULL_CONF ]]; then
  ANSIBLE_PULL_ENABLED=1
  SYSTEM_STEPS=(update ansible_pull target)
fi
# Set by update_system when dnf installed or upgraded at least one package.
UPDATES_INSTALLED=0
declare -A STEP_STATE=()

# Brand palette, sampled from the Syncopated logo: a violet mark and an ember
# wordmark, each with a dim tone for the light glyphs. Each entry is
# (hex for gum and 24-bit terminals, 256-color index for other terminals).
VIOLET=('#7B4FE0' 98)
VIOLET_DIM=('#4B3A8C' 60)
VIOLET_LIGHT=('#A98BF0' 141)
EMBER=('#D2601A' 166)
EMBER_DIM=('#7A3A1C' 94)

# Theme gum's prompts with the palette. GUM_* values already set by the user win.
export GUM_CHOOSE_HEADER_FOREGROUND=${GUM_CHOOSE_HEADER_FOREGROUND:-${VIOLET_LIGHT[0]}}
export GUM_CHOOSE_CURSOR_FOREGROUND=${GUM_CHOOSE_CURSOR_FOREGROUND:-${EMBER[0]}}
export GUM_CHOOSE_SELECTED_FOREGROUND=${GUM_CHOOSE_SELECTED_FOREGROUND:-${EMBER[0]}}

