# Syncopated installer kickstart.
#
# tasks/blueprint.yml embeds this file in every prepared blueprint as
# [customizations.installer.kickstart] contents, after the lines that
# templates/kickstart.toml.j2 renders: lang, keyboard, timezone, rootpw --lock,
# the user commands, and a first %pre that writes the generation-time disk
# layout (/tmp/syncopated-layout.env and /tmp/syncopated-layout.ks).
# image-builder puts its own payload %include in front. Edit this file, not
# the blueprints. It must not contain three consecutive single quotes (TOML
# literal string delimiter) or Jinja delimiters.
#
# The install asks nothing. The only possible prompt is the LUKS passphrase
# when the intent sets disk.encrypt.

graphical
firstboot --disable
reboot
network --bootproto=dhcp --activate --onboot=on

# Pick one target disk, check it, count down on a tty, then write the rendered
# layout for that disk to /tmp/partitions.ks.
# Excluded: the disk holding the install media, removable, read-only and USB
# disks. NVMe disks win over other disks; among equals the largest wins.
# Volume sizes are fixed in /tmp/syncopated-layout.ks (computed from
# disk.size_gib at generation time); this script only fills in the disk name
# and gives the space a larger-than-declared disk has to /home.
%pre --interpreter=/usr/bin/bash --erroronfail --log=/tmp/syncopated-pre.log
set -uo pipefail

OUT=${SYNC_PRE_OUT:-/tmp/partitions.ks}
TTY=${SYNC_PRE_TTY:-/dev/tty1}
CMDLINE=${SYNC_PRE_CMDLINE:-/proc/cmdline}
LAYOUT=${SYNC_PRE_LAYOUT:-/tmp/syncopated-layout.env}
LAYOUT_KS=${SYNC_PRE_LAYOUT_KS:-/tmp/syncopated-layout.ks}
# The countdown runs on its own virtual console: tty1 belongs to Anaconda's
# tmux session, which would swallow the key press.
COUNT_TTY=${SYNC_PRE_COUNTDOWN_TTY:-/dev/tty8}
COUNT_IN=${SYNC_PRE_COUNTDOWN_IN:-$COUNT_TTY}
SLEEP=${SYNC_PRE_SLEEP:-sleep}

die() {
  echo "ERROR: $*" >&2
  echo "Syncopated install aborted: $*" >"$TTY" 2>/dev/null || true
  echo "Syncopated install aborted: $*" >>"$COUNT_TTY" 2>/dev/null || true
  exit 1
}

# Written by the first %pre: DECLARED_MIB (disk.size_gib in MiB), DISK_SERIAL
# (empty: any disk) and COUNTDOWN (seconds).
DECLARED_MIB=
DISK_SERIAL=
COUNTDOWN=30
# shellcheck source=/dev/null
[ -r "$LAYOUT" ] && . "$LAYOUT"
[ -n "$DECLARED_MIB" ] || die "$LAYOUT does not set DECLARED_MIB; the kickstart was not generated by the osbuild role"
[ -r "$LAYOUT_KS" ] || die "$LAYOUT_KS is missing; the kickstart was not generated by the osbuild role"

# Whole-disk name behind a block device: a partition maps to its parent.
disk_of() {
  local parent
  parent=$(lsblk -no PKNAME "$1" 2>/dev/null | head -n1)
  if [ -n "$parent" ]; then
    echo "$parent"
  else
    lsblk -dno NAME "$1" 2>/dev/null | head -n1
  fi
}

media=()
for mnt in /run/install/repo /run/install/isodir; do
  src=$(findmnt -no SOURCE "$mnt" 2>/dev/null) || continue
  [ -n "$src" ] && media+=("$(disk_of "$src")")
done
# Fallback: the inst.stage2=hd:LABEL=... boot argument names the media label.
label=$(grep -o 'LABEL=[^ :]*' "$CMDLINE" 2>/dev/null | head -n1 | cut -d= -f2-)
if [ -n "$label" ]; then
  src=$(blkid -L "$(printf '%b' "$label")" 2>/dev/null) && [ -n "$src" ] && media+=("$(disk_of "$src")")
fi
echo "install media disks: ${media[*]:-none}"

best=
best_size=0
best_nvme=0
while read -r name type rm ro size tran; do
  [ "$type" = disk ] || continue
  case $name in zram* | loop* | sr*) continue ;; esac
  if [ "$rm" != 0 ] || [ "$ro" != 0 ]; then
    echo "skip $name: removable or read-only"
    continue
  fi
  if [ "${tran:-}" = usb ]; then
    echo "skip $name: usb"
    continue
  fi
  for m in "${media[@]}"; do
    if [ "$m" = "$name" ]; then
      echo "skip $name: install media"
      continue 2
    fi
  done
  nvme=0
  case $name in nvme*) nvme=1 ;; esac
  echo "candidate $name: $size bytes, nvme=$nvme"
  if [ "$nvme" -gt "$best_nvme" ] || { [ "$nvme" -eq "$best_nvme" ] && [ "$size" -gt "$best_size" ]; }; then
    best=$name
    best_size=$size
    best_nvme=$nvme
  fi
done < <(lsblk -dbno NAME,TYPE,RM,RO,SIZE,TRAN)

[ -n "$best" ] || die "no installable disk found (install media, removable, read-only and USB disks are excluded)"

model=$(lsblk -dno MODEL "/dev/$best" 2>/dev/null | head -n1 | sed 's/[[:space:]]*$//')
serial=$(lsblk -dno SERIAL "/dev/$best" 2>/dev/null | head -n1 | sed 's/[[:space:]]*$//')
total=$((best_size / 1048576))

# Wrong-machine guards: nothing has touched a disk yet.
if [ -n "$DISK_SERIAL" ] && [ "$serial" != "$DISK_SERIAL" ]; then
  die "target disk $best (${model:-unknown model}) has serial '${serial:-none}', but the profile pins disk.serial '$DISK_SERIAL'"
fi
if [ "$total" -lt "$DECLARED_MIB" ]; then
  die "target disk $best (${model:-unknown model}) has $((total / 1024)) GiB ($total MiB), but the profile declares disk.size_gib $((DECLARED_MIB / 1024)) GiB ($DECLARED_MIB MiB); regenerate the ISO with disk.size_gib at most $((total / 1024))"
fi

# Countdown naming the disk; any key aborts, the timeout proceeds.
countdown() {
  local i key rc vt
  vt=${COUNT_TTY##*tty}
  case $vt in '' | *[!0-9]*) ;; *) chvt "$vt" 2>/dev/null || true ;; esac
  {
    printf '\n\n  Syncopated unattended installation\n\n'
    printf '  Target disk:  /dev/%s\n' "$best"
    printf '  Model:        %s\n' "${model:-unknown}"
    printf '  Serial:       %s\n' "${serial:-unknown}"
    printf '  Size:         %s GiB (declared %s GiB)\n\n' "$((total / 1024))" "$((DECLARED_MIB / 1024))"
    printf '  EVERY PARTITION ON THIS DISK WILL BE ERASED.\n'
    printf '  Press any key within %s seconds to abort.\n\n' "$COUNTDOWN"
  } >>"$COUNT_TTY" 2>/dev/null
  for ((i = COUNTDOWN; i > 0; i--)); do
    printf '\r  Installing in %3d s ' "$i" >>"$COUNT_TTY" 2>/dev/null
    if read -r -s -n 1 -t 1 key <"$COUNT_IN" 2>/dev/null; then
      die "a key was pressed during the countdown; no disk was changed"
    else
      rc=$?
      # rc > 128: the one-second timeout. Anything else (no tty, end of
      # input) returned at once; keep the one-second pace.
      [ "$rc" -gt 128 ] || $SLEEP 1
    fi
  done
  printf '\r  Installing now.      \n' >>"$COUNT_TTY" 2>/dev/null
  chvt 1 2>/dev/null || true
  : "${key:=}"
}
echo "target disk $best: $total MiB, model '${model:-unknown}', serial '${serial:-unknown}'; countdown $COUNTDOWN s"
countdown

# Fill in the disk; the surplus over the declared size goes to /home (the
# reserve stays unassigned in vg00). Without a /home volume it stays unassigned.
extra=$((total - DECLARED_MIB))
sed "s/@DISK@/$best/g" "$LAYOUT_KS" | awk -v extra="$extra" '
  /^logvol \/home / && match($0, /--size=[0-9]+/) {
    n = substr($0, RSTART + 7, RLENGTH - 7) + extra
    $0 = substr($0, 1, RSTART - 1) "--size=" n substr($0, RSTART + RLENGTH)
  }
  { print }' >"$OUT" || die "could not write $OUT"
echo "layout for $best ($extra MiB over the declared size go to /home):"
cat "$OUT"
%end

%include /tmp/partitions.ks

# Create the system flatpak repository so /etc/flatpak/remotes.d (the Flathub
# remote) is applied at install time. flatpak imports remotes.d files only
# when root first opens /var/lib/flatpak/repo; until then a user running
# `flatpak remotes` sees no remotes. Runs inside the installed system.
%post --interpreter=/usr/bin/bash --log=/root/syncopated-post.log
if command -v flatpak >/dev/null 2>&1; then
  flatpak remotes --system --columns=name,url
fi
# The OpenSCAP remediation (CIS) can mask cockpit at build time. Unmask it here,
# after the payload is installed, so the web console stays available.
# Harmless when cockpit is not installed.
systemctl unmask cockpit.socket cockpit.service || true
systemctl enable cockpit.socket || true
%end
