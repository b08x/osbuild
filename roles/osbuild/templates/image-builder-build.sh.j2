#!/usr/bin/env bash
# {{ ansible_managed | default('Managed by Ansible') }}
# Build {{ osbuild_blueprint_name }} ({{ osbuild_distro }} {{ osbuild_image_type }} {{ osbuild_arch }}).
# Written by the osbuild role in generate-only mode (osbuild_only_generate: true).
# Runs the same image-builder command as tasks/build.yml, then copies the
# newest image to {{ osbuild_output_filename }}{{ ' and loads it into podman' if osbuild_image_type in ['container', 'container-minimal'] else '' }}.
#
#   bash {{ osbuild_output_dir }}/build-{{ osbuild_blueprint_name }}.sh
#
# This script, the blueprint and the ISO are mode 0600: the blueprint and the
# ISO carry password hashes and, with remote logging, the client key.
set -euo pipefail
cd "$(dirname "$(readlink -f "$0")")"

stamp=$(mktemp)
trap 'rm -f "$stamp"' EXIT
{% if osbuild_extra_repo_urls | default([]) | length > 0 %}

# Pre-flight: depsolve aborts when any --extra-repo has a repomd.xml that lists
# a file the server does not serve (an interrupted publish upstream). Check
# every file repomd.xml lists before the build starts, and fail with the repo
# name. SKIP_REPO_PREFLIGHT=1 skips the check.
extra_repos=(
{% for url in osbuild_extra_repo_urls %}
  {{ url | quote }}
{% endfor %}
)

repo_preflight() {
  local base repomd loc bad=0
  for base in "${extra_repos[@]}"; do
    case $base in
      *\?*) echo "preflight: $base: metalink, not checked"; continue ;;
    esac
    base=${base%/}
    if ! repomd=$(curl -fsL --retry 3 --retry-delay 2 --max-time 60 "$base/repodata/repomd.xml"); then
      echo "preflight: $base: repodata/repomd.xml is not downloadable" >&2
      bad=1
      continue
    fi
    while IFS= read -r loc; do
      if ! curl -fsL --retry 3 --retry-delay 2 --max-time 60 -o /dev/null -r 0-0 "$base/$loc"; then
        echo "preflight: $base: repomd.xml lists $loc but the server does not serve it" >&2
        bad=1
      fi
    done < <(printf '%s\n' "$repomd" | grep -o '<location href="[^"]*"' | sed 's/^<location href="//; s/"$//')
  done
  return "$bad"
}

if [ "${SKIP_REPO_PREFLIGHT:-0}" != 1 ]; then
  echo "Pre-flight: checking {{ osbuild_extra_repo_urls | length }} extra repositories"
  if ! repo_preflight; then
    echo "A repository is inconsistent or unreachable; the depsolve would fail. Retry later, or SKIP_REPO_PREFLIGHT=1 to build anyway." >&2
    exit 1
  fi
fi
{% endif %}

sudo image-builder build {{ osbuild_image_type | quote }} \
  --distro {{ osbuild_distro | quote }} \
  --arch {{ osbuild_arch | quote }} \
  --blueprint {{ (osbuild_blueprint_name ~ '.toml') | quote }}{% for url in osbuild_extra_repo_urls | default([]) %} \
  --extra-repo {{ url | quote }}{% endfor %}


image=$(find . -maxdepth 2 -type f \( -name '*.iso' -o -name '*.qcow2' -o -name '*.img' -o -name '*.tar' \) \
  -newer "$stamp" -printf '%T@ %p\n' | sort -rn | head -n1 | cut -d' ' -f2-)
if [ -z "$image" ]; then
  echo "image-builder finished but no new image was found under $PWD" >&2
  exit 1
fi
sudo cp "$image" {{ osbuild_output_filename | quote }}
sudo chown "$(id -u):$(id -g)" {{ osbuild_output_filename | quote }}
# The ISO carries the user password hashes (and remote logging keys): 0600.
chmod 0600 {{ osbuild_output_filename | quote }}
ls -lh {{ osbuild_output_filename | quote }}
{% if osbuild_image_type in ['container', 'container-minimal'] %}

# Container types produce an OCI archive; load it into the invoking user's
# (rootless) podman store and tag it.
podman load -i {{ osbuild_output_filename | quote }} \
  | sed -n 's/^Loaded image: //p' \
  | xargs -r -I{} podman tag {} {{ osbuild_container_tag | quote }}
podman image ls {{ osbuild_container_tag | regex_replace(':[^:/]*$', '') | quote }}
{% endif %}
