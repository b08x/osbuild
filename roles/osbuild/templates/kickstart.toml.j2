# Installer kickstart (roles/osbuild/files/{{ osbuild_kickstart_file }}). Injected
# into every prepared blueprint by tasks/blueprint.yml; edit the source file,
# not this. Rendered here: lang/keyboard/timezone (osbuild_locale,
# osbuild_keyboard, osbuild_timezone), the locked root account, the users
# (tasks/credentials.yml: SHA-512 hashes of throwaway passwords) and the
# {{ _osbuild_disk_layout.layout }} disk layout computed at generation time
# for a {{ osbuild_disk_size_gib }} GiB disk (tasks/disk_layout.yml).

[customizations.installer.kickstart]
contents = '''
lang {{ osbuild_locale }}
keyboard {{ osbuild_keyboard }}
timezone {{ osbuild_timezone }} --utc
rootpw --lock
{% for u in _osbuild_users %}
user --name={{ u.name }} --gecos="{{ u.gecos }}" --groups={{ u.groups | join(',') }}{{ (' --uid=' ~ u.uid) if u.uid is defined and u.uid is not none else '' }} --iscrypted --password={{ u.password_hash }}
{% if u.ssh_pubkey | default('', true) | length > 0 %}
sshkey --username={{ u.name }} "{{ u.ssh_pubkey }}"
{% endif %}
{% endfor %}
%pre --interpreter=/usr/bin/bash --erroronfail
cat >/tmp/syncopated-layout.env <<'EOF'
DECLARED_MIB={{ _osbuild_disk_layout.disk_mib }}
DISK_SERIAL={{ osbuild_disk_serial }}
COUNTDOWN={{ osbuild_kickstart_countdown | int }}
EOF
cat >/tmp/syncopated-layout.ks <<'EOF'
ignoredisk --only-use=@DISK@
zerombr
clearpart --all --initlabel --disklabel=gpt --drives=@DISK@
bootloader --boot-drive=@DISK@
reqpart
{% if _osbuild_disk_layout.layout == 'compliant' %}
part /boot --size=2048 --fstype=xfs --fsoptions="nodev,nosuid" --ondisk=@DISK@
{% else %}
part /boot --size=2048 --fstype=xfs --ondisk=@DISK@
{% endif %}
part pv.00 --size=1 --grow --ondisk=@DISK@{{ ' --encrypted' if osbuild_disk_encrypt | bool else '' }}
volgroup vg00 pv.00
{% for v in _osbuild_disk_layout.volumes %}
logvol {{ v.mount }} --vgname=vg00 --name={{ v.name }} --size={{ v.size_mib }} --fstype=xfs{{ (' --fsoptions="' ~ v.fsoptions ~ '"') if v.fsoptions else '' }}
{% endfor %}
EOF
%end
{{ lookup('ansible.builtin.file', osbuild_kickstart_file, rstrip=false) }}
{% if _osbuild_disk_layout.layout == 'compliant' and osbuild_disk_tmp == 'tmpfs' %}
# /tmp as tmpfs with the hardening mount options (disk.tmp: tmpfs).
%post --interpreter=/usr/bin/bash
echo 'tmpfs /tmp tmpfs defaults,nodev,nosuid,noexec,mode=1777,size={{ (osbuild_kickstart_compliant_tmp_gib | int) * 1024 }}M 0 0' >>/etc/fstab
%end
{% endif %}
{% if _osbuild_users | length > 0 %}
# The generated passwords are throwaway: each user picks a new one at first
# login (GDM asks).
%post --interpreter=/usr/bin/bash --log=/root/syncopated-users.log
{% for u in _osbuild_users %}
chage -d 0 {{ u.name }}
{% endfor %}
%end
{% endif %}
'''
