#
# {{ ansible_managed | default('Managed by Ansible') }}
# Written by the osbuild role (tasks/hardening.yml) for a standalone
# {{ osbuild_hardening }} workstation. The OpenSCAP tailoring unselects the
# stock rules these settings deviate from, so the tailored scan reports them
# as not selected, not failed.
#
# Logs rotate within a fixed cap: max_log_file x num_logs =
# {{ _osbuild_audit.max_log_file }} MB x {{ _osbuild_audit.num_logs }} = {{ _osbuild_audit.max_log_file * _osbuild_audit.num_logs }} MB on the {{ _osbuild_audit.volume_gib }} GiB /var/log/audit volume.
# A full or failing audit volume never halts, suspends or single-users the
# system. Below {{ osbuild_audit_warn_free_percent }}% free, syncopated-audit-warn
# warns in the journal, motd, Cockpit and GNOME.
#
local_events = yes
write_logs = yes
log_file = /var/log/audit/audit.log
log_group = root
log_format = ENRICHED
flush = INCREMENTAL_ASYNC
freq = 50
max_log_file = {{ _osbuild_audit.max_log_file }}
num_logs = {{ _osbuild_audit.num_logs }}
priority_boost = 4
name_format = NONE
max_log_file_action = rotate
space_left = {{ osbuild_audit_warn_free_percent }}%
space_left_action = exec /usr/local/sbin/syncopated-audit-warn
verify_email = yes
action_mail_acct = root
admin_space_left = {{ osbuild_audit_admin_free_percent }}%
admin_space_left_action = rotate
disk_full_action = rotate
disk_error_action = syslog
use_libwrap = yes
tcp_listen_queue = 5
tcp_max_per_addr = 1
tcp_client_max_idle = 0
transport = TCP
krb5_principal = auditd
distribute_network = no
q_depth = 2000
overflow_action = syslog
max_restarts = 10
plugin_dir = /etc/audit/plugins.d
end_of_event_timeout = 2
