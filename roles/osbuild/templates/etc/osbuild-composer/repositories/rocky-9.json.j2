{#-
  osbuild-composer repository override for Rocky Linux (dl.rockylinux.org,
  citations.md items 2/6). Generic over the `repo` dict from vars/Rocky.yml,
  same body as almalinux-10.json.j2. Consumed via osbuild_repo_config_template
  when callers want to override the distro-shipped rocky definitions
  (--force-data-dir is the image-builder fallback, citations.md item 3).
#}
{
    "x86_64": [
        {% for repo_name, repo_data in repo.items() %}
        {
            "name": "{{ repo_name }}",
            "check_gpg": {{ repo_data.check_gpg | to_json }},
            {% if repo_data.metalink is defined %}
            "metalink": "{{ repo_data.metalink }}"
            {% else %}
            "baseurl": "{{ repo_data.baseurl }}"
            {% endif %}
            {% if repo_gpgkeys is defined and repo_name in repo_gpgkeys %}
            ,"gpgkey": {{ repo_gpgkeys[repo_name] | to_json }}
            {% endif %}
        }{{ "," if not loop.last else "" }}
        {% endfor %}
    ]
}
