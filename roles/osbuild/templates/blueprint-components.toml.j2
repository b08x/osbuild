# Generated by the osbuild role from components: {{ osbuild_blueprint_components | join(', ') }}
name = "{{ osbuild_blueprint_name }}"
description = "{{ osbuild_blueprint_description }}"
version = "{{ osbuild_blueprint_version }}"
distro = "{{ osbuild_distro }}"

packages = [
{% for p in (_osbuild_bp_packages | unique) %}
    { name = "{{ p }}", version = "{{ osbuild_package_pins.get(p, '*') }}" },
{% endfor %}
]

[customizations]
{% if osbuild_image_type | default('') != 'container' %}
hostname = "{{ osbuild_hostname }}"
{% endif %}

{{ lookup('ansible.builtin.file', osbuild_blueprint_frame_path) }}
{% if _osbuild_bp_kernel_args %}
[customizations.kernel]
append = "{{ _osbuild_bp_kernel_args | join(' ') }}"

{% endif %}
{% if _osbuild_bp_services or _osbuild_bp_services_disabled | default([]) %}
[customizations.services]
enabled = [
{% for s in _osbuild_bp_services %}
    "{{ s }}",
{% endfor %}
]
{% if _osbuild_bp_services_disabled | default([]) %}
disabled = [
{% for s in _osbuild_bp_services_disabled %}
    "{{ s }}",
{% endfor %}
]
{% endif %}

{% endif %}
{% for f in _osbuild_bp_fragments %}
# --- component fragment: {{ f }} ---
{{ lookup('ansible.builtin.file', osbuild_components_dir ~ '/' ~ f) }}
{% endfor %}
{% if _osbuild_bp_openscap_unselected | default([]) %}

# OpenSCAP tailoring (tasks/hardening.yml): image-builder runs autotailor on
# the profile above and remediates with the tailored profile.
[customizations.openscap.tailoring]
unselected = [
{% for r in _osbuild_bp_openscap_unselected %}
    "xccdf_org.ssgproject.content_rule_{{ r }}",
{% endfor %}
]
{% endif %}
