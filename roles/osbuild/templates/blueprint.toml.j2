# SPDX-License-Identifier: MIT-0
# Dynamically generated blueprint for {{ ansible_distribution }} image builds
# Generated by Ansible role: osbuild
# Components: {{ osbuild_components | join(', ') }}

name = "{{ osbuild_blueprint_name }}"
description = "{{ osbuild_blueprint_description }}"
version = "{{ osbuild_blueprint_version }}"
distro = "{{ osbuild_distro }}"

# =============================================================================
# Package Groups (from components)
# =============================================================================

{% for c in osbuild_components %}
{% if c in osbuild_component_defs and osbuild_component_defs[c].blueprint_groups is defined %}
{% for g in osbuild_component_defs[c].blueprint_groups %}
[[groups]]
name = "{{ g }}"
{% endfor %}
{% endif %}
{% endfor %}

# =============================================================================
# Packages (from selected components)
# =============================================================================

{% for c in osbuild_components %}
{%- if c in osbuild_component_defs and osbuild_component_defs[c].packages is defined %}
{%-   for package in osbuild_component_defs[c].packages %}
[[packages]]
name = "{{ package }}"
version = "{{ osbuild_package_pins.get(package, '*') }}"
{%   endfor %}
{%- endif %}
{%- endfor %}

{%- for package in osbuild_extra_packages %}
[[packages]]
name = "{{ package }}"
version = "{{ osbuild_package_pins.get(package, '*') }}"
{% endfor %}

# =============================================================================
# Kernel Arguments
# =============================================================================

{% set ns = namespace(kargs=[]) %}
{% for c in osbuild_components %}
{% if c in osbuild_component_defs and osbuild_component_defs[c].kernel_args is defined and osbuild_component_defs[c].kernel_args %}
{% set ns.kargs = ns.kargs + [osbuild_component_defs[c].kernel_args] %}
{% endif %}
{% endfor %}
{% if ns.kargs %}
[customizations.kernel]
append = "{{ ns.kargs | join(' ') }}"
{% endif %}

# =============================================================================
# Services
# =============================================================================

{% set ns2 = namespace(services=[]) %}
{% for c in osbuild_components %}
{% if c in osbuild_component_defs and osbuild_component_defs[c].services is defined %}
{% set ns2.services = ns2.services + osbuild_component_defs[c].services %}
{% endif %}
{% endfor %}
{% set all_services = ns2.services %}

[customizations.services]
enabled = [
{% for service in all_services | unique %}
  "{{ service }}",
{% endfor %}
]

# =============================================================================
# Timezone & Locale
# =============================================================================

[customizations.timezone]
timezone = "{{ osbuild_timezone }}"

[customizations.locale]
languages = ["{{ osbuild_locale }}"]
keyboard = "{{ osbuild_keyboard }}"

# =============================================================================
# Installer
# =============================================================================
# No [[customizations.user]]: Anaconda creates the user (see
# files/kickstart/syncopated.ks). The Users module must be enabled explicitly
# because image-builder only adds it when the blueprint defines users.

[customizations.installer.modules]
enable = ["org.fedoraproject.Anaconda.Modules.Users"]
disable = ["org.fedoraproject.Anaconda.Modules.Subscription"]

# =============================================================================
# Component File Injections
# =============================================================================

{% for c in osbuild_components %}
{% if c in osbuild_component_defs and osbuild_component_defs[c].files is defined %}
{% for f in osbuild_component_defs[c].files %}
[[customizations.files]]
path = "{{ f.path }}"
{% if f.mode is defined %}mode = "{{ f.mode }}"
{% endif %}data = '''
{{ f.content }}
'''
{% endfor %}
{% endif %}
{% endfor %}

{% if 'nvidia' in osbuild_components %}
# =============================================================================
# NVIDIA CDI (Container Device Interface) — podman GPU passthrough
# =============================================================================

[[customizations.files]]
path = "/usr/local/bin/nvidia-cdi-generate.sh"
mode = "0755"
data = '''
{% include 'snippets/nvidia-cdi.sh.j2' %}'''

[[customizations.files]]
path = "/etc/systemd/system/nvidia-cdi-refresh.service"
data = '''
{% include 'systemd/nvidia-cdi-refresh.service.j2' %}'''
{% endif %}
