#!/usr/bin/env bash
# lsblk stub. Disk list from $LSBLK_DISKS (lines: NAME TYPE RM RO SIZE [TRAN]),
# partition parents from $LSBLK_PARENTS (lines: /dev/PART PARENT), serial and
# model from $LSBLK_INFO (lines: NAME SERIAL MODEL...).
case "$*" in
  "-dbno NAME,TYPE,RM,RO,SIZE,TRAN") cat "$LSBLK_DISKS" ;;
  "-no PKNAME "*) awk -v d="${*: -1}" '$1 == d { print $2 }' "$LSBLK_PARENTS" ;;
  "-dno NAME "*) dev="${*: -1}"; echo "${dev#/dev/}" ;;
  "-dno SERIAL "*) dev="${*: -1}"; awk -v d="${dev#/dev/}" '$1 == d { print $2 }' "${LSBLK_INFO:-/dev/null}" ;;
  "-dno MODEL "*) dev="${*: -1}"; awk -v d="${dev#/dev/}" '$1 == d { $1 = ""; $2 = ""; sub(/^ +/, ""); print }' "${LSBLK_INFO:-/dev/null}" ;;
  *) echo "lsblk stub: unexpected args: $*" >&2; exit 2 ;;
esac
