#!/usr/bin/env bash
# git stub: `ls-remote` fails for any URL containing "bad".
source "${STUB_DIR:?}/_lib.sh"
stub_log "git $*"
if [[ ${1:-} == ls-remote ]]; then
  url=${*: -1}
  if [[ $url == *bad* ]]; then
    echo "fatal: repository '$url' not found" >&2
    exit 128
  fi
  printf 'deadbeef\tHEAD\n'
fi
exit 0
